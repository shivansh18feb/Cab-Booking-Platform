# ==============================================================================
# Cab Booking Application - Global Environment Configuration Template
# Copy this file to .env and configure values before starting the application.
# ==============================================================================

# --- Application Profiles & Ports ---
SPRING_PROFILES_ACTIVE=dev
PORT=8080
FRONTEND_PORT=5173

# --- Database Configuration (PostgreSQL) ---
# For local PostgreSQL or Docker Compose:
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cabbooking
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
# In dev profile, falls back to in-memory H2 if local postgres is unavailable.

# --- Security & JWT Authentication ---
# Ensure JWT secret is at least 256 bits (32 characters or hex/base64 encoded)
APP_JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
APP_JWT_ACCESS_EXPIRATION_MS=900000        # 15 minutes
APP_JWT_REFRESH_EXPIRATION_MS=604800000    # 7 days

# --- CORS Allowed Origins ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://cab-booking-platform-seven.vercel.app

# --- Google OAuth2 (Optional for Social Login) ---
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_ID=your-google-client-id
SPRING_SECURITY_OAUTH2_CLIENT_REGISTRATION_GOOGLE_CLIENT_SECRET=your-google-client-secret

# --- Razorpay Payments (Test Mode) ---
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
RAZORPAY_CURRENCY=INR

# --- Mail Service (Transactional Emails) ---
SPRING_MAIL_HOST=smtp.mailtrap.io
SPRING_MAIL_PORT=2525
SPRING_MAIL_USERNAME=your_username
SPRING_MAIL_PASSWORD=your_password
SPRING_MAIL_FROM=support@cabride.local

# --- Map & Geocoding Provider ---
# OpenStreetMap / Nominatim is used as default without requiring API keys.
# Set Google Maps API key if Google Maps integration is desired:
VITE_GOOGLE_MAPS_API_KEY=
VITE_API_BASE_URL=http://localhost:8080/api/v1
VITE_WS_BASE_URL=http://localhost:8080/ws
